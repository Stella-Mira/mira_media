{
  "name": "mira_media",
  "version": "2.0.0",
  "description": "DSH「声音」插件：语音合成（TTS）/ 语音识别（ASR）/ 断句（VAD 切分），持有唯一一份阿里云凭据；对外提供 miraMedia 服务与 device_say / media_status，设置页「声音」，页面侧带一个全局播放器",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "tts",
    "asr",
    "vad",
    "dashscope"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stella-Mira/mira_media.git"
  }
}
